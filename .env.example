# agenTeX environment variables.
#
# Copy this file to `.env` and fill in the values you want. The server
# auto-loads `.env` at startup if python-dotenv is installed (`pip install
# python-dotenv` in the agentex conda env). Otherwise, `source .env` in
# your shell before launching `python server.py`.

# ---- Direct-API path (Anthropic) ----
# Required for the "Comment + ask Claude" button in Cmd+K and the
# "Ask Claude" buttons in the comments sidebar. When unset, those buttons
# don't render and the only response path is via Claude Code / Desktop
# chat (which uses your subscription instead of API credits).
ANTHROPIC_API_KEY=

# Model used by the direct-API response endpoint. Pick anything Anthropic's
# /v1/messages accepts. Common options:
#   claude-sonnet-4-5     (balanced — default)
#   claude-haiku-4-5      (fast / cheap; good for short replies)
#   claude-opus-4-5       (powerful / slower)
AGENTEX_API_MODEL=claude-sonnet-4-5

# ---- Server runtime ----
# Host and port the FastAPI server binds to. Leave defaults unless you have
# a reason to change them.
AGENTEX_HOST=127.0.0.1
AGENTEX_PORT=8000

# Base URL the MCP tools use to talk to the running server. Match HOST/PORT
# above. Override only if the MCP server lives on a different machine.
AGENTEX_BASE=http://127.0.0.1:8000

# Python interpreter used by `EnsureServerRunning` when it spawns the
# server. Defaults to whatever the MCP server itself is running under;
# override if you want a different env to host the spawned process.
# AGENTEX_PYTHON=/Users/ynot/code/software/miniconda3/envs/agentex/bin/python
