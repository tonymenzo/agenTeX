# agenTeX environment variables.
#
# Three places get loaded at startup, in order of decreasing precedence:
#   1. shell env  (`export ANTHROPIC_API_KEY=...`)
#   2. <project>/.env
#   3. ~/.config/agentex/env  — user-level defaults; survives brew upgrade
#
# Use this file as a per-project template (copy to <project>/.env), or
# manage the user-level file with:
#   agentex set ANTHROPIC_API_KEY=sk-...
#   agentex set                 # list (secrets redacted)
#   agentex unset ANTHROPIC_API_KEY
#
# Loading the .env files needs python-dotenv (`pip install python-dotenv`,
# or it's included automatically when you install agentex itself).

# ============================================================ #
# ==================== Default LLM selection ================= #
# ============================================================ #
# Provider + model used by the "Ask Claude" buttons and Cmd+K when no
# per-request override is supplied. Each `respond` API call accepts
# {provider, model, host} in its body to override these.
#
# Supported providers:
#   anthropic  openai  google  groq  mistral  ollama  bedrock  vllm  litellm
AGENTEX_API_PROVIDER=anthropic
AGENTEX_API_MODEL=claude-sonnet-4-5

# ============================================================ #
# ==================== Cloud provider API keys =============== #
# ============================================================ #
# Set whichever keys you want enabled. The picker greys out providers
# whose key (or host, for openai-compatible) is missing.

# Anthropic — Claude (claude-sonnet-4-5, claude-haiku-4-5, claude-opus-4-1, …)
ANTHROPIC_API_KEY=

# OpenAI — GPT (gpt-4o-mini, gpt-4o, o1-mini, …)
OPENAI_API_KEY=

# Google — Gemini (gemini-2.0-flash-exp, gemini-1.5-pro, …)
GOOGLE_API_KEY=

# Groq — open models on Groq cloud (llama-3.3-70b-versatile, …)
GROQ_API_KEY=

# Mistral — mistral-large-latest, mistral-small-latest, …
MISTRAL_API_KEY=

# AWS Bedrock — set the access key id; the orchestral client picks up the
# rest of the AWS env (secret, region, etc.) from your shell.
AWS_ACCESS_KEY_ID=

# ============================================================ #
# ============= Local / self-hosted (OpenAI-compatible) ====== #
# ============================================================ #
# vLLM and LiteLLM speak the OpenAI /v1/chat/completions wire format,
# so they reuse orchestral's GPT client with an overridden base_url.

# vLLM server (must include /v1 suffix)
# Example: http://localhost:8000/v1
AGENTEX_VLLM_HOST=
# Any non-empty value works if the server was launched without --api-key.
VLLM_API_KEY=

# LiteLLM proxy (must include /v1 suffix)
# Example: http://localhost:4000/v1
AGENTEX_LITELLM_HOST=
# Virtual key minted by the proxy admin (sk-...).
LITELLM_API_KEY=

# ============================================================ #
# ====================== Spend tracking ====================== #
# ============================================================ #
# Hard caps on direct-API spend. Reached limits return HTTP 402 from
# /api/comments/{id}/respond; the frontend disables the Ask Claude
# buttons. Unset means "no limit." Numbers are USD.
#
# Spend is recorded in .agentex/spend.jsonl (one line per API call) with
# {ts, provider, model, comment_id, cost_usd, tokens}.
AGENTEX_SPEND_LIMIT_DAILY=
AGENTEX_SPEND_LIMIT_SESSION=

# ============================================================ #
# ======================== Server runtime ==================== #
# ============================================================ #
AGENTEX_HOST=127.0.0.1
AGENTEX_PORT=8000
AGENTEX_BASE=http://127.0.0.1:8000
# Python interpreter for spawned `EnsureServerRunning` child. Defaults
# to whatever the MCP server runs under.
# AGENTEX_PYTHON=/Users/ynot/code/software/miniconda3/envs/agentex/bin/python
